@model SUMMERA.Application.DTOs.Hotels.CreateHotelDto

@{
    ViewData["Title"] = "Add New Hotel";
}

<div class="admin-page-header">
    <div>
        <h1>🏨 Add New Hotel</h1>
        <p>Fill in the details below to add a new hotel</p>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn-secondary">← Back to List</a>
</div>

<div class="admin-form-card">
    @if (TempData["Error"] != null)
    {
        <div class="admin-alert admin-alert-error">@TempData["Error"]</div>
    }

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="admin-form-group">
            <label asp-for="Name">Hotel Name</label>
            <input asp-for="Name" placeholder="e.g. Nile Ritz Hotel" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="admin-form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="4" placeholder="Brief description..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="admin-form-group">
            <label asp-for="Address">Address</label>
            <input asp-for="Address" placeholder="e.g. Downtown, Cairo" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="admin-form-group">
            <label asp-for="CityId">City</label>
            <select asp-for="CityId" asp-items="ViewBag.Cities">
                <option value="">-- Select City --</option>
            </select>
            <span asp-validation-for="CityId" class="text-danger"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="admin-form-group">
                <label asp-for="StarRating">Star Rating (1-5)</label>
                <input asp-for="StarRating" type="number" min="1" max="5" />
                <span asp-validation-for="StarRating" class="text-danger"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="StartingPrice">Starting Price ($)</label>
                <input asp-for="StartingPrice" type="number" step="0.01" min="0" />
                <span asp-validation-for="StartingPrice" class="text-danger"></span>
            </div>
        </div>

        <div class="admin-form-group">
            <label asp-for="MainImageUrl">Image URL (optional)</label>
            <input asp-for="MainImageUrl" placeholder="/images/Hotels/my-hotel.png" />
            <span asp-validation-for="MainImageUrl" class="text-danger"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Save Hotel</button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}