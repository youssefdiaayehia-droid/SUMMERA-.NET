@model SUMMERA.Application.DTOs.Rooms.CreateRoomDto

@{
    ViewData["Title"] = "Edit Room";
    var roomId = ViewBag.RoomId;
}

<div class="admin-page-header">
    <div>
        <h1>✏️ Edit Room</h1>
        <p>Update room details</p>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn-secondary">← Back to List</a>
</div>

<div class="admin-form-card">
    <form asp-action="Edit" asp-route-id="@roomId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="admin-form-group">
            <label asp-for="HotelId">Hotel</label>
            <select asp-for="HotelId" asp-items="ViewBag.Hotels">
                <option value="">-- Select Hotel --</option>
            </select>
            <span asp-validation-for="HotelId" class="text-danger"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="admin-form-group">
                <label asp-for="RoomNumber">Room Number</label>
                <input asp-for="RoomNumber" />
                <span asp-validation-for="RoomNumber" class="text-danger"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="RoomType">Room Type</label>
                <input asp-for="RoomType" />
                <span asp-validation-for="RoomType" class="text-danger"></span>
            </div>
        </div>

        <div class="admin-form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="admin-form-group">
                <label asp-for="PricePerNight">Price Per Night ($)</label>
                <input asp-for="PricePerNight" type="number" step="0.01" min="0" />
                <span asp-validation-for="PricePerNight" class="text-danger"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Capacity">Capacity (Guests)</label>
                <input asp-for="Capacity" type="number" min="1" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Update Room</button>
            <a asp-action="Index" class="admin-btn admin-btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}