@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />
}

<div class="background"><div class="bg-overlay"></div></div>

<div class="identity-wrapper">
    <div class="identity-card" style="text-align: center;">
        <div style="font-size: 4rem; margin-bottom: 1rem;">📧</div>
        <h1>Email Sent</h1>
        <p class="identity-subtitle">
            Please check your email to reset your password.
        </p>

        <div class="identity-links">
            <a asp-page="./Login">Back to Login</a>
        </div>
    </div>
</div>