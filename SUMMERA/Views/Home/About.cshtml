@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4">About SUMMERA</h1>
            <p class="lead">
                SUMMERA is your trusted partner for finding and booking the perfect hotel.
            </p>
            <hr />
            <h3>Our Mission</h3>
            <p>
                We help travelers discover amazing accommodations around the world
                with just a few clicks. Whether you're on a business trip or a family vacation,
                SUMMERA has the right hotel for you.
            </p>

            <h3>Why Choose Us?</h3>
            <ul>
                <li><i class="fas fa-check text-success"></i> Wide selection of hotels</li>
                <li><i class="fas fa-check text-success"></i> Best prices guaranteed</li>
                <li><i class="fas fa-check text-success"></i> Secure booking process</li>
                <li><i class="fas fa-check text-success"></i> 24/7 customer support</li>
            </ul>

            <h3>Contact Us</h3>
            <p>
                Have questions? <a asp-controller="Contact" asp-action="Index">Get in touch with us</a>.
            </p>
        </div>
    </div>
</div>